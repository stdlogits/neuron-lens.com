{
  "name": "neuron-lens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "neuron-lens.com: what the neurons and attention heads inside open language models respond to, and what they make the model say.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "e2e:fixtures": "node e2e/fixtures/build.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@stdlogits/ledger": "github:stdlogits/ledger#v0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.4.6",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  }
}
